   "t0": 58.5,
   "t1": 60.27,
   "text": "ISO 42001,"
  },
  {
   "i": 20,
   "beat": 97.5,
   "t0": 60.938,
   "t1": 62.639,
   "text": "the NIST AI [RMF],"
  },
  {
   "i": 21,
   "beat": 101.2,
   "t0": 63.25,
   "t1": 64.93,
   "text": "the [UAE] [PDPL],"
