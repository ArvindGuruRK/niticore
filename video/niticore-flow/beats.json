 "vo": [
  {
   "i": 0,
   "beat": 2,
   "t0": 1.25,
   "t1": 3.27,
   "text": "The world is accelerating with AI."
  },
  {
   "i": 1,
   "beat": 7,
   "t0": 4.375,
   "t1": 7.255,
   "text": "Now, AI needs governance built for what's next."
  },
  {
   "i": 2,
   "beat": 15,
   "t0": 9.375,
   "t1": 10.815,
   "text": "Introducing Niticore."
  },
  {
   "i": 3,
   "beat": 24,
   "t0": 15.0,
   "t1": 17.34,
   "text": "AI is already everywhere in your business."
  },
  {
   "i": 4,
   "beat": 29,
   "t0": 18.125,
   "t1": 20.725,
   "text": "And the faster it moves, the harder it is to see."
  },
  {
   "i": 5,
   "beat": 36,
   "t0": 22.5,
   "t1": 23.99,
   "text": "Models no one approved."
  },
  {
   "i": 6,
   "beat": 39.5,
   "t0": 24.688,
   "t1": 26.197,
   "text": "Agents acting on their own."
  },
  {
   "i": 7,
   "beat": 43,
   "t0": 26.875,
   "t1": 28.305,
   "text": "Risks no one can measure."
  },
  {
   "i": 8,
   "beat": 48.5,
   "t0": 30.312,
   "t1": 33.032,
   "text": "Niticore brings all of it into one clear view."
  },
  {
   "i": 9,
   "beat": 54,
   "t0": 33.75,
   "t1": 35.04,
   "text": "One continuous loop."
  },
  {
   "i": 10,
   "beat": 57.0,
   "t0": 35.625,
   "t1": 36.345,
   "text": "Discover."
  },
  {
   "i": 11,
   "beat": 59.2,
   "t0": 37.0,
   "t1": 37.71,
   "text": "Assess."
  },
  {
   "i": 12,
   "beat": 61.4,
   "t0": 38.375,
   "t1": 38.965,
   "text": "Govern."
  },
  {
   "i": 13,
   "beat": 63.6,
   "t0": 39.75,
   "t1": 40.42,
   "text": "Prove."
  },
  {
   "i": 14,
   "beat": 65.6,
   "t0": 41.0,
   "t1": 41.8,
   "text": "And monitor."
  },
  {
   "i": 15,
   "beat": 70.5,
   "t0": 44.062,
   "t1": 46.873,
   "text": "Discover every model, agent and dataset."
  },
  {
   "i": 16,
   "beat": 80,
   "t0": 50.0,
   "t1": 52.873,
   "text": "Assess the risk of each one, the moment it appears."
  },
  {
   "i": 17,
   "beat": 86,
   "t0": 53.75,
   "t1": 55.9,
   "text": "Align with governance frameworks such as"
  },
  {
   "i": 18,
   "beat": 90.4,
   "t0": 56.5,
   "t1": 57.87,
   "text": "the EU AI Act,"
