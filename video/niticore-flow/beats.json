   "t1": 114.35,
   "text": "workforce,"
  },
  {
   "i": 37,
   "beat": 183.9,
   "t0": 114.938,
   "t1": 115.698,
   "text": "government,"
  },
  {
   "i": 38,
   "beat": 186.2,
   "t0": 116.375,
   "t1": 117.765,
   "text": "retail and consumer,"
  },
  {
   "i": 39,
   "beat": 188.6,
   "t0": 117.875,
   "t1": 119.875,
   "text": "and infrastructure and mobility."
  },
  {
   "i": 40,
   "beat": 198.0,
   "t0": 123.75,
   "t1": 126.27,
   "text": "So you can innovate with confidence, and prove it."
  },
