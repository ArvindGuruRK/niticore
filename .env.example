# Book a demo: emails are sent through Resend by the requestDemo server action.
# Copy to .env.local for local testing. Never commit real values.

# Added automatically when Resend is installed from the Vercel Marketplace
# (vercel integration add resend), then `vercel env pull` brings it into .env.local.
RESEND_API_KEY=

# Where each demo request is delivered. Several addresses may be comma-separated.
# While testing with Resend's test sender, use the email of the Resend account.
DEMO_TEAM_EMAIL=

# Optional. The sender, on a domain verified in Resend, e.g. "Niticore <demo@example.com>".
# Leave empty to use Resend's test sender (onboarding@resend.dev), which only delivers to the
# Resend account's own email.
DEMO_FROM_EMAIL=

# The live site address, used for links and the logo inside emails. Defaults to https://niticore.vercel.app
NEXT_PUBLIC_SITE_URL=

# Optional. Id of a Vercel Firewall rate-limit rule (Rate Limiting SDK) for the Book a demo action,
# counted per client IP across every instance and region. The in-memory limits always apply too.
DEMO_RATE_LIMIT_ID=

# ---------------------------------------------------------------------------------------------
# Payload CMS (Blog and News, edited at /admin). Without DATABASE_URL and PAYLOAD_SECRET the CMS is
# off: /blog and /news show their empty state and the rest of the site works as normal.

# Postgres connection string. In production: Neon from the Vercel Marketplace
# (vercel integration add neon), which sets DATABASE_URL for you. For local work, use a separate
# database (a Neon development branch, or local Postgres), never the production one.
# After pulling new migrations, run `npm run migrate` against your local database.
DATABASE_URL=

# Signs CMS sign-in sessions. A long random string, e.g. the output of `openssl rand -hex 32`.
# Changing it signs every editor out.
PAYLOAD_SECRET=

# Optional locally, needed in production. Vercel Blob storage for CMS images
# (Vercel dashboard > Storage > Blob, connect to this project). Without it, images are saved in
# the /media folder, which doesn't persist on Vercel.
BLOB_READ_WRITE_TOKEN=
